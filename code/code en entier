
# ==========================================
# BASE DE DONNEES DES COMPTES BANCAIRES
# ==========================================

comptes_bancaires = {
    "123456": {"code": "4321", "solde": 1500, "plafond": 500, "plafond restant":500, "historique": []},
    "654321": {"code": "0000", "solde": 45, "plafond": 200, "plafond restant": 200, "historique": []},
    "987654": {"code": "9999", "solde": 12000, "plafond": 1500, "plafond restant": 1500, "historique": []}
}


# ==========================================
# ETAT DE LA SESSION
# ==========================================

carte_inseree = None
essais_restants = 3

differents_billets = [100, 50, 20, 10]


# ==========================================
# FONCTIONS DE LA CARTE BANCAIRE
# ==========================================

def inserer_carte(numero_carte):
    global carte_inseree, essais_restants

    print("--- Insertion de la carte ---")

    if numero_carte in comptes_bancaires:
        print("Carte acceptée. Lecture de la puce en cours...")

        carte_inseree = numero_carte
        essais_restants = 3

        return carte_inseree, essais_restants

    else:
        print("Erreur : Carte invalide ou non reconnue.")
        return None, 0


def authentifier(code_saisi):
    """Vérifie le code PIN saisi"""

    global carte_inseree, essais_restants

    if not carte_inseree:
        print("Aucune carte insérée.")
        return False

    compte = comptes_bancaires[carte_inseree]

    if code_saisi == compte["code"]:
        print("Code PIN correct. Authentification réussie.")
        return True

    else:
        essais_restants -= 1

        print(f"Code PIN incorrect. Essais restants : {essais_restants}")

        if essais_restants == 0:
            print("Sécurité : Nombre d'essais maximal atteint.")
            print("Carte avalée, veuillez voir un de nos agents pour la recupérer.")
            carte_inseree = None

        return False

def verifier_identite():

    global carte_inseree
    print("-- VERIFICATION DE SECURITE --")
    code = input("Veuillez confirmer votre code PIN : ")
    if carte_inseree is None:
        return False

    compte = comptes_bancaires[carte_inseree]
    if code == compte["code"]:
        print("Identité confirmée.")
        print("Vous pouvez continuer.")
        return True
    else:
        print("Code PIN incorrect.")
        print("Votre carte est avalée.")
        print("Votre carte est conservée en sécurité à la banque.")
        print("Un message est envoyé à la banque.")
        carte_inseree = None
        return False


def avaler_carte():
    global carte_inseree
    print("\nAucune réponse détectée.")
    print("Votre carte est avalée.")
    print("Votre carte est conservée en sécurité à la banque.")
    print("Un message est envoyé à la banque.")

    carte_inseree = None
# ==========================================
# FONCTIONS DU RETRAIT
# ==========================================

def afficher_menu_retrait():
    print("===========")
    print("-- RETRAIT --")
    print("===========")


def demander_montant():
    while True:
        try:
            montant = int(input("Veuillez entrer un montant à retirer : "))
            return montant

        except ValueError:
            print("Erreur : veuillez entrer un nombre entier.")


def verifier_montant(montant, plafond, solde):

    if montant <= 0:
        print("Erreur : le montant doit être supérieur à 0.")
        return False

    elif montant % 10 != 0:
        print("Erreur : le montant doit être divisible par 10.")
        return False

    elif montant > plafond:
        print(f"Erreur : votre plafond restant est de {plafond} €.")
        return False

    elif montant > solde:
        print("Erreur : solde insuffisant.")
        return False

    return True


def effectuer_retrait(solde, montant):
    nouveau_solde = solde - montant

    print("Action réussie ! Votre retrait a été effectué.")
    print(f"Montant retiré : {montant} €")
    print(f"Votre nouveau solde est de : {nouveau_solde} €")

    return nouveau_solde


def retrait():

    compte = comptes_bancaires[carte_inseree]

    afficher_menu_retrait()

    while True:

        montant = demander_montant()

        plafond = compte["plafond restant"]
        solde = compte["solde"]

        if verifier_montant(montant, plafond, solde):

            nouveau_solde = effectuer_retrait(solde, montant)

            compte["solde"] = nouveau_solde

            compte["plafond restant"] -= montant

            compte["historique"].append(montant)

            billets(montant)

            break


# ==========================================
# FONCTION DU DEPOT
# ==========================================

def depot():

    compte = comptes_bancaires[carte_inseree]

    print("===========")
    print("-- DEPOT --")
    print("===========")

    while True:
        try:
            montant = int(input("Combien souhaitez-vous déposer ? "))

            if montant <= 0:
                print("Le montant doit être supérieur à 0.")

            elif montant % 10 != 0:
                print("Le montant doit être divisible par 10.")

            else:
                compte["solde"] += montant

                compte["historique"].append(-montant)

                print("Dépôt effectué avec succès !")
                print(f"Montant déposé : {montant} €")
                print(f"Nouveau solde : {compte['solde']} €")

                break

        except ValueError:
            print("Veuillez entrer un nombre entier.")


# ==========================================
# FONCTIONS DE DISTRIBUTION DES BILLETS
# ==========================================

def calculer_billets(montant, valeur_billet):

    nombre_billets = montant // valeur_billet
    reste = montant % valeur_billet

    return nombre_billets, reste


def afficher_billets(nombre, valeur):

    if nombre > 0:
        print(f"Voici {nombre} billet(s) de {valeur} €.")


def billets(montant_donne):

    print("===========")
    print("-- BILLETS --")
    print("===========")

    for valeur in differents_billets:

        nombre, reste = calculer_billets(montant_donne, valeur)

        afficher_billets(nombre, valeur)

        montant_donne = reste

    if montant_donne > 0:
        print("Impossible de distribuer la totalité du montant.")

# ==========================================
# FONCTIONS DU MENU PRINCIPAL
# ==========================================

def afficher_menu():

    print("\n===========")
    print("-- MENU --")
    print("===========")
    print("1 - Consulter mon solde")
    print("2 - Retirer de l'argent")
    print("3 - Quitter")
    print("4 - Consulter mon historique")
    print("5 - Déposer de l'argent")

    debut = time.time()

    try:
        nb = int(input("Choisissez une commande entre 1 et 5 : "))

    except ValueError:
        print("Veuillez entrer un nombre valide.")
        return 0

    duree = time.time() - debut
    # Quitter normalement
    if nb == 3:
        return 3
    # Vérifier le délai de saisie
    if duree > 15:

        print("\nAucune activité détectée.")
        print("Vérification de votre identité nécessaire.")
        
        if verifier_identite():
            return nb
        else:
            return -1
    return nb



def consulter():

    compte = comptes_bancaires[carte_inseree]

    solde = compte["solde"]
    plafond = compte["plafond restant"]

    print(f"Votre solde est de {solde} €")
    print(f"Votre plafond restant est de {plafond} €")

def afficher_historique():

    compte = comptes_bancaires[carte_inseree]

    historique = compte["historique"]

    print("========================")
    print("-- HISTORIQUE DES OPERATIONS --")
    print("========================")

    if len(historique) == 0:
        print("Aucune opération effectuée.")

    else:
        for montant in historique:

            if montant > 0:
                print(f"Retrait de {montant} €")

            else:
                print(f"Dépôt de {-montant} €")


def retirer_carte():

    global carte_inseree

    print("Veuillez récupérer votre carte.")

    carte_inseree = None

    print("Merci de votre visite !")


# ==========================================
# PROGRAMME PRINCIPAL
# ==========================================

numero_carte = input("Veuillez insérer votre carte : ")

inserer_carte(numero_carte)

if carte_inseree is not None:

    authentifie = False

    while essais_restants > 0 and not authentifie:

        code = input("Veuillez saisir votre code PIN : ")

        authentifie = authentifier(code)

    if authentifie:

        while True:

            nb = afficher_menu()

            # Carte avalée
            if nb == -1:
                retirer_carte()
                break

            # Consulter le solde
            elif nb == 1:
                consulter()

            # Retirer de l'argent
            elif nb == 2:
                retrait()

            # Quitter
            elif nb == 3:
                retirer_carte()
                break

            # Historique
            elif nb == 4:
                afficher_historique()

            # Dépôt
            elif nb == 5:
                depot()

            else:
                print("Le nombre saisi est incorrect.")
    else:
        print("Authentification impossible.")
else:
    print("Veuillez utiliser une carte valide.")
